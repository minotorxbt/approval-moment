# Copy this file to ".env" and paste your key after the "=" sign.
# Never commit ".env" (it is already in .gitignore).
# Leave it empty to run in demo mode (rules only, no network).
NEAR_AI_API_KEY=
# Optional overrides:
# NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# PORT=3000

# Optional: NEAR TESTNET mode (real transfers of test NEAR, no real money).
# Do not fill these in by hand: run `npm run testnet:setup`, it creates the keys for you.
# NEAR_TESTNET=1
# NEAR_TESTNET_AGENT_KEY=
# NEAR_TESTNET_ESCROW_KEY=

# Optional: pre-fills the NEAR key check box on the page (a public testnet account id, not a secret)
# NEAR_DEMO_ACCOUNT=yourname.testnet
